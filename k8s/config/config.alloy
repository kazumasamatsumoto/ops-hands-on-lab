// 本格版(Kubernetes)の Grafana Alloy の設定です。Pod のログを Kubernetes の API から読み、Loki へ送ります。
// 軽量版(observability/alloy/config.alloy)は Docker のソケットから読みましたが、本格版では kubectl logs と同じ仕組みで読みます。
// 付けるラベルは軽量版と同じ(project・service・container)にしてあるので、Grafana のダッシュボードのログのパネルはそのまま使えます。
//
// cdn-waf はクラスタの外(ただの Docker のコンテナ)なので、ここでは集めません。見るときは docker logs <クラスタ名>-cdn-waf。
// CCv2 でも、CDN・WAF のログはお客さんの側の契約で見るもので、Cloud Portal から開くログ(SAP Cloud Logging の OpenSearch Dashboards)には入りません。

// 1. lab の部屋と ingress-nginx の部屋にいる Pod の一覧を Kubernetes から教えてもらう
discovery.kubernetes "pods" {
  role = "pod"
  namespaces {
    names = ["lab", "ingress-nginx"]
  }
}

// 2. Loki で探しやすいよう、ラベル(付箋)を付ける
//    service   … Pod のラベル app.kubernetes.io/name(storefront・api・backoffice・worker・db・search・prometheus など)
//                ingress-nginx のコントローラーは、軽量版と同じ名前 ingress にします
//    pod       … Pod の名前(同じ service でも、どの Pod のログか分かる)
//    container … コンテナの名前
discovery.relabel "pods" {
  targets = discovery.kubernetes.pods.targets

  rule {
    source_labels = ["__meta_kubernetes_pod_label_app_kubernetes_io_name"]
    target_label  = "service"
  }
  rule {
    source_labels = ["__meta_kubernetes_namespace", "__meta_kubernetes_pod_label_app_kubernetes_io_component"]
    regex         = "ingress-nginx;controller"
    target_label  = "service"
    replacement   = "ingress"
  }
  // ingress-nginx の部屋の、コントローラー以外(最初に 1 回だけ動く準備の Job)は集めません。
  rule {
    source_labels = ["__meta_kubernetes_namespace", "service"]
    regex         = "ingress-nginx;ingress-nginx"
    action        = "drop"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_name"]
    target_label  = "pod"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_container_name"]
    target_label  = "container"
  }
  rule {
    target_label = "project"
    replacement  = "lab"
  }
}

// 3. 各 Pod のログを Kubernetes の API から読む
loki.source.kubernetes "pods" {
  targets    = discovery.relabel.pods.output
  forward_to = [loki.process.json.receiver]
}

// 4. JSON のログから「レベル」を取り出してラベルにする(軽量版と同じ)
//    trace_id はラベルにしません(値の種類が多すぎて Loki が重くなるため)。ログの本文に入ったままでも、
//    Grafana の Loki のデータソースの「derived field」が本文から trace_id を見つけて、Tempo へのリンクにします。
loki.process "json" {
  stage.json {
    expressions = { level = "level" }
  }
  stage.template {
    source   = "level"
    template = "{{ if eq .Value \"30\" }}info{{ else if eq .Value \"40\" }}warn{{ else if eq .Value \"50\" }}error{{ else if eq .Value \"60\" }}fatal{{ else if eq .Value \"20\" }}debug{{ else }}{{ .Value }}{{ end }}"
  }
  stage.labels {
    values = { level = "" }
  }
  forward_to = [loki.write.local.receiver]
}

// 5. Loki へ送る
loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
